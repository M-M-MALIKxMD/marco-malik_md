# Bot Settings
BOT_NAME=Marco Malik MD Bot
OWNER_NAME=Marco Malik
OWNER_NUMBER=923001234567
PREFIX=.
MODE=public
VERSION=5.0

# Auth Session Directory
AUTH_DIR=auth_info

# OpenAI (for .ai .gpt .imagine commands)
# Get from: https://platform.openai.com/api-keys
